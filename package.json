{
  "name": "@luiskr/shared",
  "version": "5.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/main.js",
    "./tests/*": "./tests/*",
    "./build/*": "./build/*",
    "./scripts/*": "./scripts/*"
  },
  "sideEffects": true,
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --coverage",
    "version:patch": "yarn version --patch --no-git-tag-version",
    "version:minor": "yarn version --minor --no-git-tag-version",
    "version:major": "yarn version --major --no-git-tag-version"
  },
  "dependencies": {
    "@luiskr/core": "1.0.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "typescript": "^6.0.3"
  }
}
